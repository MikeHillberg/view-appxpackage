<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ViewAppxPackage.CompositeValueEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViewAppxPackage"
    Title="Edit Composite Value"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    PrimaryButtonClick="Save_Click"
    FullSizeDesired="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto" >

        <!-- Toolbar -->
        <CommandBar HorizontalAlignment="Left" Margin="0,0,0,4">
                <AppBarButton Click="Delete_Click" Label="Delete" Icon="Delete"/>
                <AppBarButton Click="Edit_Click" Label="Edit" Icon="Edit"/>
            <AppBarButton Click="Add_Click" Label="Add" Icon="Add"/>
        </CommandBar>
        <TextBlock x:Name="_errorText" Grid.Row="1" Foreground="Red" Visibility="Collapsed" Margin="0,0,0,4"/>

        <!-- Selectable list of key/value pairs -->
        <ListView x:Name="_listView" Grid.Row="2" SelectionMode="Single" ItemsSource="{x:Bind Entries}" SelectionChanged="ListView_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CompositeValueEntry">
                    <Grid Padding="4,8" RowDefinitions="Auto,Auto,Auto,Auto">
                        <!-- View mode: Key bold, Value below, type shown -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Key, Mode=OneWay}" FontWeight="Bold"
                                       Tapped="ViewText_Tapped"/>
                            <!--<TextBlock Text="{x:Bind TypeName, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Tapped="ViewText_Tapped"/>-->
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{x:Bind Value, Mode=OneWay}" TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Visibility="{x:Bind ViewVisibility, Mode=OneWay}"
                                   Tapped="ViewText_Tapped"/>

                        <!-- Edit mode: Key TextBox, Type ComboBox, Value TextBox, and item-level Save/Cancel -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Visibility="{x:Bind EditingVisibility, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Key"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:CompositeValueEntry.SupportedTypeNames}"
                                          SelectedIndex="{x:Bind SelectedTypeIndex, Mode=TwoWay}"
                                          MinWidth="120"/>
                                <CheckBox Grid.Column="2" Content="Array" IsChecked="{x:Bind IsArray, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox Grid.Row="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Value" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,4,0,4"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <TextBlock VerticalAlignment="Top"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}">Example:</TextBlock>
                                <TextBlock Text="{x:Bind ExampleString, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Click="ItemSave_Click" Style="{StaticResource AccentButtonStyle}" Content="Save"/>
                                <Button Click="ItemCancel_Click" Content="Cancel"/>
                                <TextBlock Text="Invalid value" Foreground="Red" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

    </Grid>
    </ScrollViewer>
</ContentDialog>
